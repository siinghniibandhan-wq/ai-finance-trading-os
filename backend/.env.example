# Configure these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets. Values below are examples only.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Your own user id from the users table (safer than ADMIN_EMAIL; set this).
ADMIN_USER_ID=
ADMIN_EMAIL=

# Exact frontend origins, comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Set to 1 only if nginx / a load balancer sits in front of the app.
TRUSTED_PROXY_COUNT=

# Leave unset in production (hides /docs). 1 = show API docs.
ENABLE_API_DOCS=

# Use the HTTPS URL of the deployed m.Stock gateway service on Vercel.
# Local development may use http://127.0.0.1:8000.
MSTOCK_GATEWAY_URL=
MSTOCK_GATEWAY_SECRET=


# OmniRoute and FreeLLMAPI gateway settings (keep values on the server only).
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=

# Set to true only to explicitly allow paid OmniRoute models (OFF by default).
AI_ALLOW_PAID_MODELS=
