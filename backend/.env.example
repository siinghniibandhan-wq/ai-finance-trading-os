# Copy to .env on the SERVER (never commit the real file). Values below are examples only.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Your own user id from the users table (safer than ADMIN_EMAIL; set this).
ADMIN_USER_ID=
ADMIN_EMAIL=

# Exact HTTPS frontend origins, comma separated. Localhost origins are added only in development/test.
APP_ENV=production
CORS_ALLOWED_ORIGINS=https://main.d1qcu413dz9f9e.amplifyapp.com

# Set only when nginx / a load balancer sits in front; value is the trusted proxy count.
TRUSTED_PROXY_COUNT=0

# Leave unset in production (hides /docs). 1 = show API docs.
ENABLE_API_DOCS=

MSTOCK_GATEWAY_URL=http://127.0.0.1:8000
MSTOCK_GATEWAY_SECRET=

# Optional m.Stock Type A streaming (disabled by default; backend secrets only)
MSTOCK_STREAM_ENABLED=false
MSTOCK_STREAM_URL=wss://ws.mstock.trade
MSTOCK_STREAM_API_KEY=
MSTOCK_STREAM_ACCESS_TOKEN=
MSTOCK_STREAM_INSTRUMENT_TOKENS=  # Optional explicit token override; otherwise subscribe current gateway-backed top movers.
MSTOCK_STREAM_AUTO_SUBSCRIBE_MOVERS=true
MSTOCK_STREAM_RECEIVE_TIMEOUT=2
MSTOCK_STREAM_STALE_AFTER=15

GEMINI_API_KEY_PARAMETER=
AWS_REGION=

# OmniRoute and FreeLLMAPI gateway settings (keep values on the server only).
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=

# Set to true only to explicitly allow paid OmniRoute models (OFF by default).
AI_ALLOW_PAID_MODELS=
