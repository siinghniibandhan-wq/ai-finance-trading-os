const root = document.getElementById("root");

root.innerHTML = `
  <div style="padding:30px;font-family:Arial">
    <h2>Checking React...</h2>
  </div>
`;

Promise.all([
  import("react"),
  import("react-dom/client")
])
  .then(([ReactModule, ReactDOMModule]) => {
    const React = ReactModule.default;
    const ReactDOM = ReactDOMModule;

    ReactDOM.createRoot(root).render(
      React.createElement(
        "div",
        { style: { padding: "30px", fontFamily: "Arial" } },
        React.createElement("h1", null, "React Working ✅"),
        React.createElement("p", null, "React loaded successfully.")
      )
    );
  })
  .catch((error) => {
    root.innerHTML = `
      <div style="
        padding:30px;
        font-family:Arial;
        color:#b00020;
        background:#fff0f0;
        min-height:100vh;
      ">
        <h2>React Error ❌</h2>
        <pre style="white-space:pre-wrap">${String(error?.stack || error)}</pre>
      </div>
    `;
  });
