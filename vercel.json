{
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "app.main:app",
      "bindings": [
        {
          "type": "service",
          "service": "mstock_gateway",
          "format": "url",
          "env": "MSTOCK_GATEWAY_URL"
        }
      ]
    },
    "mstock_gateway": {
      "root": "mstock-gateway/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
